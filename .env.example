APP_ENV=development
GROQ_API_KEY=coloque_sua_chave_aqui
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MODEL_ROUTER=
GROQ_STT_MODEL=whisper-large-v3-turbo
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=2
# Em development, pode ficar vazio. Em production, é obrigatório.
MILA_API_KEY=
MILA_DEBUG=false
# No Docker Compose local, use http://api:8080; fora do Docker, localhost:8080.
MINDU_API_URL=http://localhost:8080
MINDU_API_TIMEOUT_S=8
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_TOP_K=4
RAG_MIN_RELEVANCE=0.40
RAG_REWRITE_FOLLOWUPS=false
ROUTER_MIN_CONFIDENCE=0.6
HISTORY_MAX_TURNS=8
ATTACH_MAX_MB=10
SPECIALTIES=ansiedade,depressao,luto,estresse,relacionamento,sono,autismo,tdah
LOG_LEVEL=INFO
